<?xml version="1.0" encoding="utf-8"?>
<!-- Violet Chat — backup exclusion (audit fix 2026-10-25).
     The local SQLite cache holds DECRYPTED message history and the
     shared-prefs/secure storage hold session material: NOTHING from
     this app may ever be backed up. allowBackup=false plus this
     fullBackupContent rule (Android <=11 belt-and-suspenders). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
