rules_version = '2';

// ============================================================
// Violet Chat — Cloud Firestore Security Rules
// ============================================================
// قواعد صارمة: قاعدة البيانات ليست مفتوحة للقراءة أو الكتابة
// العامة إطلاقاً. كل وثيقة ملف مستخدم مقفلة على مالكها (UID من
// Firebase Authentication).
//
// ملاحظة تركيبية (إصلاح 2026-10-22): الدوال يجب أن تعيش داخل
// بلوك service، وربط المسار {uid} لا يُرى داخل الدوال — يُمرَّر
// كوسيط صريح. اكتُشف الخطأ عند أول نشر فعلي للقواعد.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // المالك وحده: جلسة مصادقة سارية بنفس uid المسار.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // حمولة إنشاء الملف: uid يطابق المسار + حقول هوية سليمة.
    // uid يمرَّر كوسيط (ربط المسار لا يُرى داخل الدوال).
    function validProfileCreate(uid) {
      return request.resource.data.uid == uid
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() >= 2
             && request.resource.data.email is string;
    }

    // ملف المستخدم: المالك وحده يقرأ ويكتب.
    // لا مستخدم يستطيع قراءة ملفات الآخرين أو تعديلها بأي حال.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfileCreate(uid);
      // التحديث لا يغير uid ولا email (الهوية الأساسية ثابتة).
      allow update: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email == resource.data.email;
      allow delete: if false; // حذف الملف ليس ميزة في v0.1.x
    }

    // أي مسار آخر مرفوض صراحةً (deny-by-default صريح).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
